# The supervisor stage copies only its own package, so it downloads no module
# and links no verifier.
FROM golang:1.24.5 AS supervisor
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/zisk-supervisor ./cmd/zisk-supervisor
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/zisk-supervisor ./cmd/zisk-supervisor

FROM nvidia/cuda:12.9.1-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    xz-utils \
    jq \
    curl \
    procps \
    build-essential \
    qemu-system \
    libomp-dev \
    libgmp-dev \
    nlohmann-json3-dev \
    protobuf-compiler \
    uuid-dev \
    libgrpc++-dev \
    libsecp256k1-dev \
    libsodium-dev \
    libpqxx-dev \
    nasm \
    libopenmpi-dev \
    openmpi-bin \
    openmpi-common \
    libclang-dev \
    clang \
    gcc-riscv64-unknown-elf \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ARG ZISK_VERSION=1.2.0-alpha

# The release archive has the layout ziskup installs. Extracted into
# /root/.zisk it supplies the binaries, the ziskc and ziskclib archives, and
# the emulator-asm and lib-c sources.
RUN curl -fSL "https://github.com/0xPolygonHermez/zisk/releases/download/v${ZISK_VERSION}/cargo_zisk_linux_amd64.tar.gz" -o /tmp/zisk.tar.gz \
    && mkdir -p /root/.zisk \
    && tar --no-same-owner -xzf /tmp/zisk.tar.gz -C /root/.zisk \
    && rm /tmp/zisk.tar.gz \
    && chmod +x /root/.zisk/bin/*

# Overlay of the worker and the coordinator from han0110/zisk 15ac629d.
RUN curl -fSL "https://github.com/han0110/zisk/releases/download/test-15ac629d4ffa2eb212acc5c79f5ed3b3c6f7ee12/cargo_zisk_linux_amd64.tar.gz" -o /tmp/zisk-patched.tar.gz \
    && tar --no-same-owner -xzf /tmp/zisk-patched.tar.gz -C /root/.zisk ./bin/zisk-worker-gpu ./bin/zisk-coordinator \
    && rm /tmp/zisk-patched.tar.gz \
    && chmod +x /root/.zisk/bin/zisk-worker-gpu /root/.zisk/bin/zisk-coordinator

COPY --from=supervisor /out/zisk-supervisor /root/.zisk/bin/zisk-supervisor

ENV PATH="/root/.zisk/bin:${PATH}"

CMD ["bash"]
