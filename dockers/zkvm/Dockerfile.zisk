FROM nvidia/cuda:12.9.1-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    xz-utils \
    jq \
    curl \
    procps \
    build-essential \
    qemu-system \
    libomp-dev \
    libgmp-dev \
    nlohmann-json3-dev \
    protobuf-compiler \
    uuid-dev \
    libgrpc++-dev \
    libsecp256k1-dev \
    libsodium-dev \
    libpqxx-dev \
    nasm \
    libopenmpi-dev \
    openmpi-bin \
    openmpi-common \
    libclang-dev \
    clang \
    gcc-riscv64-unknown-elf \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ARG ZISK_VERSION=1.1.0-alpha

# The release archive carries the same layout ziskup installs, so extracting it
# into /root/.zisk yields bin/{zisk-worker-gpu,zisk-coordinator,cargo-zisk-dev-gpu},
# the ziskc/ziskclib archives, and the emulator-asm and lib-c sources the worker
# compiles a per-ELF assembly emulator from at run time.
RUN curl -fSL "https://github.com/0xPolygonHermez/zisk/releases/download/v${ZISK_VERSION}/cargo_zisk_linux_amd64.tar.gz" -o /tmp/zisk.tar.gz \
    && mkdir -p /root/.zisk \
    && tar --no-same-owner -xzf /tmp/zisk.tar.gz -C /root/.zisk \
    && rm /tmp/zisk.tar.gz \
    && chmod +x /root/.zisk/bin/*

# Overlay of a worker from han0110/zisk 30ece0c0, which caches the Main instruction table upstream
# rebuilds every proof and serves the health endpoint the container healthcheck probes.
# Remove it once a release carries both.
RUN curl -fSL "https://github.com/han0110/zisk/releases/download/test-30ece0c002e8316247c679645c6e1c35e2c65d79/cargo_zisk_linux_amd64.tar.gz" -o /tmp/zisk-patched.tar.gz \
    && tar --no-same-owner -xzf /tmp/zisk-patched.tar.gz -C /root/.zisk ./bin/zisk-worker-gpu \
    && rm /tmp/zisk-patched.tar.gz \
    && chmod +x /root/.zisk/bin/zisk-worker-gpu

ENV PATH="/root/.zisk/bin:${PATH}"

CMD ["bash"]
