# Per node addresses. scripts/desensitize.sh replaces any value appearing
# in synced results with its variable name, longer values first so a
# fully qualified host wins over the short hostname it contains.
NODE1_IP=10.0.0.1
NODE2_IP=10.0.0.2
NODE3_IP=10.0.0.3
NODE4_IP=10.0.0.4
NODE1_HOST=node1.example.com
NODE2_HOST=node2.example.com
NODE3_HOST=node3.example.com
NODE4_HOST=node4.example.com
NODE1_HOSTNAME=node1
NODE2_HOSTNAME=node2
NODE3_HOSTNAME=node3
NODE4_HOSTNAME=node4
# SSH destinations, resolved by the local ssh binary so an alias from
# ~/.ssh/config works in place of a user and host. These fill the cluster
# templates under examples/ via scripts/provoor.sh.
NODE1_SSH=user@node1.example.com
NODE2_SSH=user@node2.example.com
NODE3_SSH=user@node3.example.com
NODE4_SSH=user@node4.example.com
# Coordinator reachable from the benchmark node. COORDINATOR_IP fills the run
# templates under benchmarkoor/examples/provoor via scripts/benchmarkoor.sh,
# and the other two are the defaults scripts/sync.sh pulls results with.
COORDINATOR_IP=10.0.0.1
COORDINATOR_SSH=user@node1.example.com
REMOTE_RESULTS_DIR=/home/user/provoor/provoor-runs/results
